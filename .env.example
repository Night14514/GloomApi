# Database (ОБЯЗАТЕЛЬНО для продакшена)
# Для продакшена используйте PostgreSQL для сохранения ключей между деплоями
# DATABASE_URL=postgresql://user:password@host:port/database
# Локально используется SQLite: sqlite:///./search.db (ключи не сохраняются между деплоями)
DATABASE_URL=postgresql://user:password@host:port/database

# Telegram Bot (обязательно для работы бота)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
ADMIN_TELEGRAM_IDS=123456789,987654321

# API (опционально, по умолчанию http://localhost:8000)
# API_BASE_URL=https://your-app.railway.app

# SECURITY SETTINGS (ОБЯЗАТЕЛЬНО ДЛЯ ЗАЩИТЫ)
# MASTER_API_KEY - мастер-ключ для создания/удаления API ключей через HTTP
# Сгенерируйте сильный ключ: python -c "import secrets; print(secrets.token_urlsafe(32))"
MASTER_API_KEY=your_master_api_key_here

# ADMIN_IP_WHITELIST - список IP адресов, которым разрешены админские операции (через запятую)
# Оставьте пустым для отключения проверки IP
ADMIN_IP_WHITELIST=127.0.0.1,10.0.0.1

# ALLOWED_ORIGINS - список разрешенных CORS origins (через запятую)
# Оставьте пустым для разрешения всех origins (не рекомендуется для продакшена)
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# RATE LIMITING - ограничение запросов для защиты от DDoS
# RATE_LIMIT_REQUESTS - максимальное количество запросов за период
# RATE_LIMIT_PERIOD - период в секундах
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
